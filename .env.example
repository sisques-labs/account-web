# Upstream API this Next.js server proxies to (app/api/[...path]/route.ts,
# app/graphql/route.ts). Not exposed to the browser.
INTERNAL_API_URL=http://localhost:3000

# Browser-facing endpoints — default to same-origin proxy paths.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_GRAPHQL_URL=/graphql
NEXT_PUBLIC_HTTP_TIMEOUT_MS=10000
